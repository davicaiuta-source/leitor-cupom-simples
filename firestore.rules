rules_version = '2';

// Regras do Firestore para o Leitor de Cupom Fiscal.
// Cole no Firebase: Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(gid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }

    // Cadastro individual: cada pessoa só acessa os próprios dados
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Código -> grupo. Dá para consultar um código específico, mas não listar todos
    match /groupCodes/{code} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Cadastro coletivo
    match /groups/{gid} {
      allow get: if signedIn();

      // quem cria é o dono e o único participante
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // participantes podem mexer na lista/nome; quem tem o código só pode se adicionar
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'name'])
        && (
          request.auth.uid in resource.data.members
          || (
            request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
          )
        );

      // cupons e categorias do grupo: só participantes
      match /{rest=**} {
        allow read, write: if isMember(gid);
      }
    }
  }
}
